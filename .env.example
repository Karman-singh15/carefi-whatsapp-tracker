# Google AI Studio key (aistudio.google.com -> Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Twilio console -> Account info; sandbox number from Messaging -> Try it out -> WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

# Portal logins, comma separated user:password pairs
AGENTS=agent:change-me
# Long random string; keeps people logged in across restarts
SESSION_SECRET=

DATA_DIR=./data
PORT=3000

# twiml = reply inside the webhook (works on Twilio trial/sandbox); rest = send via API (needs a paid sender)
REPLY_MODE=twiml
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
